# Main integrates two model families with separate Python environments.
# Prefer ONE model template, copied to an ignored local file:
#   cp .env.pi05.example .env.pi05
#   source .env.pi05
#   source scripts/env.sh kinova
# or in a separate, OpenVLA environment:
#   cp .env.openvla.example .env.openvla
#   source .env.openvla
#   source scripts/env.sh openvla-libero
# All paths below are optional defaults; no credentials belong here.
export PI05_DEPLOY_ROOT="$PWD/.local/runtime"
export PI05_BASE_PARAMS="$PI05_DEPLOY_ROOT/models/pi05_base/params"
export PI05_LIBERO_FOURWAY_ROOT="$PWD/.local/runs/libero_fourway"
export PI05_LIBERO_REFERENCE_ROOT="$PI05_LIBERO_FOURWAY_ROOT"
export PI05_LIBERO_PLAIN_ROOT="$PWD/.local/runs/libero_plain_prototype"
export KINOVA_CANDIDATE_ROOT="$PWD/.local/data/kinova_candidate"
export KINOVA_EXPERIMENT_ROOT="$PWD/.local/runs/kinova"
export CL_VLA_ARCHIVE_ROOT="$PWD/.local/archive"
export OPENVLA_BASE_PATH="$PWD/.local/models/openvla-7b"
export VLA_PATH="$OPENVLA_BASE_PATH"
export OPENVLA_DATA_ROOT="$PWD/.local/data"
export LOGS_ROOT="$PWD/.local/runs/openvla"
