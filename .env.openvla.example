# Copy to a local .env.openvla and source from the repository root. Never commit tokens.
export OPENVLA_BASE_PATH="$PWD/.local/models/openvla-7b"
export VLA_PATH="$OPENVLA_BASE_PATH"
export OPENVLA_DATA_ROOT="$PWD/.local/data"
export LOGS_ROOT="$PWD/.local/runs/openvla"
export HF_HOME="$PWD/.local/cache/huggingface"
export WANDB_MODE=offline
# Optional device choices for reviewed legacy launchers:
# export GPUS=0
# export EVAL_GPUS=0
